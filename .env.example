# Скопируйте в .env и при необходимости поменяйте.
# Ключей API не нужно: модель работает локально через Ollama.

OLLAMA_URL=http://localhost:11434
OLLAMA_MODEL=qwen2.5:7b

# Сколько секунд ждать ответа модели (на процессоре 7B-модель думает 1–3 минуты)
LLM_TIMEOUT_S=600
# Чем ниже, тем меньше «фантазии» у модели
LLM_TEMPERATURE=0.2
# Сколько раз переспрашивать модель, если ответ не прошёл проверки
MAX_ATTEMPTS=3
